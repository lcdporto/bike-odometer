{
	"name": "bike-sensor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "vite dev",
		"dev:backend": "bun --cwd=apps/backend run dev",
		"dev:all": "bun run dev:backend & bun run dev",
		"build": "vite build",
		"build:backend": "bun --cwd=apps/backend run build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:backend": "bun --cwd=apps/backend run check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"build-app": "node scripts/build.js",
		"build-app-dev": "node scripts/build.js --dev",
		"install-app-debug-local": "node scripts/build.js --debug-local --install",
		"install-app": "node scripts/build.js --install",
		"install-app-dev": "node scripts/build.js --dev --install && vite dev --host"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.8.1",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"bits-ui": "^2.11.0",
		"clsx": "^2.1.1",
		"eslint": "^9.39.1",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"@capacitor-community/bluetooth-le": "^7.3.0",
		"@capacitor-community/sqlite": "^7.0.2",
		"@capacitor/android": "^8.0.0",
		"@capacitor/app": "^8.0.0",
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.0.0",
		"@capacitor/core": "^8.0.0",
		"@capacitor/device": "^8.0.0",
		"@capacitor/ios": "^8.0.0",
		"@capacitor/status-bar": "^8.0.0",
		"@squareetlabs/capacitor-navigation-bar": "^1.1.2",
		"chart.js": "^4.5.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "2.0.0-next.27",
		"mode-watcher": "^1.1.0"
	}
}
